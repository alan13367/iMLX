    "persona.library.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create easy role-based assistants for things like budgeting, coding, writing, or studying. Pick a starter and tweak it, or build your own from simple guided fields."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea asistentes por rol para presupuestos, código, escritura o estudio. Elige un inicio y ajústalo, o crea el tuyo con campos guiados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻松创建预算、编程、写作或学习等场景的角色助手。可选入门模板微调，或用简单引导字段自建。"
          }
        }
      }
    },
