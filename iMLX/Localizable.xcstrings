    "web_search.privacy.point_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each message sent with web search enabled is used online. iMLX may rewrite the current message into a short search query before sending it to DuckDuckGo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada mensaje enviado con búsqueda web activada se usa online. iMLX puede reescribir el mensaje actual como una consulta de búsqueda breve antes de enviarlo a DuckDuckGo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用网页搜索后发送的每条消息都会在线使用。iMLX 可能会先将当前消息改写成简短的搜索查询，再发送给 DuckDuckGo。"
          }
