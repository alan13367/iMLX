      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each message sent with web search enabled is used online. iMLX may rewrite the current message into a short search query before sending it to DuckDuckGo."
