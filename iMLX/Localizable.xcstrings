        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está desactivada, iMLX usa su prompt y temperatura predeterminados en segundo plano. Actívala para usar instrucciones y estilo de respuesta personalizados."
