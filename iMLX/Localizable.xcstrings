    "error.chat.generation_memory_abort" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generation was stopped to avoid a memory crash (%llu MB available). Try disabling thinking or using a smaller model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo la generación para evitar un cierre por memoria (%llu MB disponibles). Desactiva el razonamiento o usa un modelo más pequeño."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为避免内存崩溃已停止生成（可用 %llu MB）。可关闭思考模式或换用更小模型。"
          }
        }
      }
    },
