    "persona.picker.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the assistant role for this conversation. Personas control the system prompt and response style, while the currently loaded model stays unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el rol del asistente para esta conversación. Las personas controlan el mensaje del sistema y el estilo de respuesta; el modelo cargado no cambia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为此对话选择助手角色。人设控制系统提示词与回复风格，已加载的模型保持不变。"
          }
        }
      }
    },
