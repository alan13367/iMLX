    "settings.about.licenses_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMLX includes open-source components distributed under their own licenses. The app project is distributed under the MIT and Apache 2.0 licenses included with the source, and dependency licenses remain owned by their respective authors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMLX incluye componentes de código abierto distribuidos bajo sus propias licencias. El proyecto de la app se distribuye bajo las licencias MIT y Apache 2.0 incluidas con el código fuente, y las licencias de las dependencias pertenecen a sus respectivos autores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMLX 包含按各自许可证分发的开源组件。本应用项目按源码中包含的 MIT 和 Apache 2.0 许可证分发，依赖项许可证归各自作者所有。"
          }
        }
      }
    },
    "settings.about.open_source_packages" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-Source Packages"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paquetes de código abierto"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开源包"
          }
        }
      }
    },
    "settings.about.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacidad"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私"
          }
        }
      }
    },
    "settings.about.privacy_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMLX is designed for local, on-device AI. Chats and local memories stay on this device unless you explicitly enable and use network features such as Web Search or URL reading. Those network requests may send the query, URL, and returned page content through internet services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMLX está diseñado para IA local en el dispositivo. Los chats y recuerdos locales permanecen en este dispositivo salvo que actives y uses explícitamente funciones de red como Búsqueda web o lectura de URL. Esas solicitudes de red pueden enviar la consulta, la URL y el contenido devuelto de la página a través de servicios de internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMLX 专为本地设备端 AI 设计。聊天和本地记忆会保留在此设备上，除非你明确启用并使用网页搜索或 URL 读取等网络功能。这些网络请求可能会通过互联网服务发送查询、URL 和返回的网页内容。"
          }
        }
      }
    },
    "settings.about.terms" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terms"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Términos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条款"
          }
        }
      }
    },
    "settings.about.terms_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMLX runs local AI models and can produce incorrect or incomplete output. You are responsible for reviewing answers before relying on them, especially for medical, legal, financial, safety, or other high-impact decisions. Network tools are optional and only run when enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMLX ejecuta modelos de IA locales y puede producir resultados incorrectos o incompletos. Eres responsable de revisar las respuestas antes de confiar en ellas, especialmente para decisiones médicas, legales, financieras, de seguridad u otras de alto impacto. Las herramientas de red son opcionales y solo se ejecutan cuando están activadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMLX 运行本地 AI 模型，可能产生不正确或不完整的输出。在依赖回答之前，尤其是医疗、法律、财务、安全或其他高影响决策中，你有责任自行审核。网络工具是可选的，只有启用后才会运行。"
          }
        }
      }
    },
